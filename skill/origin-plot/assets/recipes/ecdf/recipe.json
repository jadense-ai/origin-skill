{
  "id": "ecdf",
  "name": "经验累积分布",
  "domain": "通用",
  "fields": [
    {
      "role": "group",
      "type": "text",
      "label": "组别"
    },
    {
      "role": "value",
      "type": "number",
      "label": "观测值"
    }
  ],
  "axes": [
    "观测值",
    "累计比例"
  ],
  "method": "按组排序，对并列值合并计数，以原生折线绘制右连续阶梯。",
  "notes": "每条记录是一次观测，保持分组首次出现的顺序。",
  "examples": [
    {
      "id": "a",
      "file": "example-a.csv",
      "title": "三批样本强度",
      "expected": {
        "layer_count": 1,
        "min_plots": [
          3
        ],
        "source_row_count": 24,
        "science": {
          "group_sizes": {
            "Batch A": 8,
            "Batch B": 8,
            "Batch C": 8
          }
        }
      },
      "expected_status": "离线科学预期；实际图层、数据绑定及导出待 Origin 实测"
    },
    {
      "id": "b",
      "file": "example-b.csv",
      "title": "两地等候时间",
      "expected": {
        "layer_count": 1,
        "min_plots": [
          2
        ],
        "source_row_count": 14,
        "science": {
          "group_sizes": {
            "Rural": 7,
            "Urban": 7
          }
        }
      },
      "expected_status": "离线科学预期；实际图层、数据绑定及导出待 Origin 实测"
    }
  ],
  "source": "原创配方；两例均为合成教学数据。",
  "template_reuse": {
    "mode": "native-otpu",
    "host_verification": "pending",
    "requires": "已授权的 Windows Origin 和可运行的 originpro"
  }
}
