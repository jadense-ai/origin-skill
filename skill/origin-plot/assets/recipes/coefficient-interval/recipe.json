{
  "id": "coefficient-interval",
  "name": "回归系数区间",
  "domain": "经管",
  "fields": [
    {
      "role": "term",
      "type": "text",
      "label": "模型项"
    },
    {
      "role": "estimate",
      "type": "number",
      "label": "系数"
    },
    {
      "role": "lower",
      "type": "number",
      "label": "区间下限"
    },
    {
      "role": "upper",
      "type": "number",
      "label": "区间上限"
    }
  ],
  "axes": [
    "系数及区间",
    "模型项"
  ],
  "method": "逐项显示输入系数与不要求对称的区间，绘制零参考线；不重新拟合。",
  "notes": "区间水平由数据提供者指定。",
  "examples": [
    {
      "id": "a",
      "file": "example-a.csv",
      "title": "薪酬模型的合成系数",
      "expected": {
        "layer_count": 1,
        "min_plots": [
          5
        ],
        "source_row_count": 3,
        "science": {
          "intervals": [
            [
              "Training",
              0.07,
              0.18,
              0.33
            ],
            [
              "Tenure",
              -0.02,
              0.07,
              0.14
            ],
            [
              "Distance",
              -0.21,
              -0.12,
              -0.04
            ]
          ]
        }
      },
      "expected_status": "离线科学预期；实际图层、数据绑定及导出待 Origin 实测"
    },
    {
      "id": "b",
      "file": "example-b.csv",
      "title": "阅读成绩的回归估计",
      "expected": {
        "layer_count": 1,
        "min_plots": [
          5
        ],
        "source_row_count": 3,
        "science": {
          "intervals": [
            [
              "Access",
              1.1,
              3.2,
              4.9
            ],
            [
              "Class size",
              -1.6,
              -0.8,
              -0.1
            ],
            [
              "Sleep",
              -0.6,
              1.3,
              3.4
            ]
          ]
        }
      },
      "expected_status": "离线科学预期；实际图层、数据绑定及导出待 Origin 实测"
    }
  ],
  "source": "原创配方；两例均为合成教学数据。",
  "template_reuse": {
    "mode": "native-otpu",
    "host_verification": "pending",
    "requires": "已授权的 Windows Origin 和可运行的 originpro"
  }
}
