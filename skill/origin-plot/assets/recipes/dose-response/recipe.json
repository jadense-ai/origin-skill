{
  "id": "dose-response",
  "name": "剂量反应",
  "domain": "生物",
  "fields": [
    {
      "role": "series",
      "type": "text",
      "label": "系列",
      "default": "Series 1"
    },
    {
      "role": "dose",
      "type": "number",
      "label": "剂量",
      "minimum": 0
    },
    {
      "role": "response",
      "type": "number",
      "label": "实测响应"
    }
  ],
  "axes": [
    "剂量",
    "实测响应"
  ],
  "method": "绘制各剂量的实测点和组内剂量均值线；不外推 EC50，不静默拟合。",
  "notes": "保留每次重复；零剂量对照允许。",
