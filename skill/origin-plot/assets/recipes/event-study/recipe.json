{
  "id": "event-study",
  "name": "事件研究动态效应",
  "domain": "经管",
  "fields": [
    {
      "role": "period",
      "type": "number",
      "label": "相对期"
    },
    {
      "role": "estimate",
      "type": "number",
      "label": "估计效应"
    },
    {
      "role": "lower",
      "type": "number",
      "label": "区间下限"
    },
    {
      "role": "upper",
      "type": "number",
      "label": "区间上限"
    }
  ],
  "axes": [
    "相对期",
    "效应及区间"
  ],
  "method": "按相对期绘制输入点估计/区间与零参考线。",
  "notes": "不代拟合模型，不虚构缺失基准期。",
